OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
# Optional overrides (defaults live in server/src/config.ts)
# DATA_DIR=./data
# DB_PATH=./data/app.db   (SQLite: jobs, attempts, audit trail, model calls; defaults to DATA_DIR/app.db)
# QUEUE_CONCURRENCY=1      (pipelines running at once)
# CATALOGUE_PATH=./catalogue/brands.json   (when deployed, put it and its ads/ folder on the persistent disk)
# PORT=4000
# PUBLIC_BASE_URL=http://localhost:4000
# DEEPGRAM_MODEL=nova-3
# MODEL_TRANSCRIBE=google/gemini-3.8-flash   (needs audio input: transcription + listening check)
# MODEL_REASON=openai/gpt-5.6-luna
